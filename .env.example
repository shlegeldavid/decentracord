# Copy to .env and replace the example host/origin with the DNS name for this VPS.
# Create the secret with restrictive host permissions; .dockerignore keeps it out of the build context:
# mkdir -p ./secrets && chmod 700 ./secrets
# umask 077; openssl rand -hex 32 | tr -d '\n' > ./secrets/db_password && chmod 600 ./secrets/db_password
DB_PASSWORD_SECRET_FILE=./secrets/db_password
DB_NAME=decentracord
DB_USER=decentracord
DB_CONNECT_TIMEOUT_MS=3000
PUBLIC_HOST=chat.example.com
APP_ORIGIN=https://chat.example.com
